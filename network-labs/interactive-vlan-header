<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Ethernet Frame & VLAN Tag Visualizer</title>
    <!-- Tailwind CSS for modern, clean styling -->
    <script src="https://tailwindcss.com"></script>
    <!-- React and Babel for component architecture -->
    <script src="https://unpkg.com" crossorigin></script>
    <script src="https://unpkg.com" crossorigin></script>
    <script src="https://unpkg.com"></script>
    <style>
        @import url('https://googleapis.com');
        body { font-family: 'Inter', sans-serif; }
        .mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">

    <div id="root" class="w-full max-w-5xl"></div>

    <script type="text/babel">
        const { useState } = React;

        function FrameVisualizer() {
            const [isTagged, setIsTagged] = useState(false);
            const [hoveredField, setHoveredField] = useState(null);

            // Data models for the fields
            const standardFields = [
                { id: 'preamble', name: 'Preamble & SFD', size: '8 Bytes', bits: '64 bits', color: 'bg-amber-600 border-amber-500', desc: 'Synchronization bytes telling the receiving network card that a new frame is arriving.' },
                { id: 'dmac', name: 'Dest MAC', size: '6 Bytes', bits: '48 bits', color: 'bg-yellow-600 border-yellow-500', desc: 'Hardware address of the destination device or next-hop router interface.' },
                { id: 'smac', name: 'Source MAC', size: '6 Bytes', bits: '48 bits', color: 'bg-emerald-600 border-emerald-500', desc: 'Hardware address of the transmitting network interface controller (NIC).' },
                { id: 'type', name: 'EtherType / Length', size: '2 Bytes', bits: '16 bits', color: 'bg-purple-600 border-purple-500', desc: 'Identifies the upper-layer protocol (e.g., 0x0800 for IPv4, 0x86DD for IPv6).' },
                { id: 'payload', name: 'Payload (Data)', size: '46-1500 B', bits: 'Variable', color: 'bg-slate-600 border-slate-500', flex: true, desc: 'The actual data being carried, containing L3 packets, L4 segments, and application layers.' },
                { id: 'fcs', name: 'FCS (CRC)', size: '4 Bytes', bits: '32 bits', color: 'bg-cyan-600 border-cyan-500', desc: 'Frame Check Sequence. A 32-bit cyclic redundancy check value used to detect transmission corruption.' }
            ];

            const taggedFields = [
                { id: 'preamble', name: 'Preamble & SFD', size: '8 Bytes', bits: '64 bits', color: 'bg-amber-600 border-amber-500', desc: 'Synchronization bytes telling the receiving network card that a new frame is arriving.' },
                { id: 'dmac', name: 'Dest MAC', size: '6 Bytes', bits: '48 bits', color: 'bg-yellow-600 border-yellow-500', desc: 'Hardware address of the destination device or next-hop router interface.' },
                { id: 'smac', name: 'Source MAC', size: '6 Bytes', bits: '48 bits', color: 'bg-emerald-600 border-emerald-500', desc: 'Hardware address of the transmitting network interface controller (NIC).' },
                { id: 'tpid', name: '802.1Q: TPID', size: '2 Bytes', bits: '16 bits', color: 'bg-blue-600 border-blue-400 font-bold ring-2 ring-blue-300 ring-offset-2 ring-offset-slate-900', desc: 'Tag Protocol Identifier. Hardcoded to 0x8100 to signal that this frame contains an 802.1Q VLAN tag.' },
                { id: 'tci', name: '802.1Q: TCI', size: '2 Bytes', bits: '16 bits', color: 'bg-blue-600 border-blue-400 font-bold ring-2 ring-blue-300 ring-offset-2 ring-offset-slate-900', desc: 'Tag Control Information. Contains subfields for Class of Service Priority (3 bits), Drop Eligibility (1 bit), and the active VLAN ID (12 bits).' },
                { id: 'type', name: 'EtherType / Length', size: '2 Bytes', bits: '16 bits', color: 'bg-purple-600 border-purple-500', desc: 'SHIFTED FIELD: The original 2-Byte EtherType field, pushed down the transmission line by the injected VLAN header.' },
                { id: 'payload', name: 'Payload (Data)', size: '42-1500 B', bits: 'Variable', color: 'bg-slate-600 border-slate-500', flex: true, desc: 'SHIFTED FIELD: The encapsulated data layer, shifted forward in time by 4 bytes.' },
                { id: 'fcs', name: 'FCS (CRC)', size: '4 Bytes', bits: '32 bits', color: 'bg-cyan-600 border-cyan-500', desc: 'RECALCULATED FIELD: Shifted and completely recomputed by the switch to factor in the new 4-byte header data.' }
            ];

            const currentFields = isTagged ? taggedFields : standardFields;
            const totalBytes = isTagged ? '1,522 Bytes max' : '1,518 Bytes max';

            return (
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-2xl">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-slate-700 pb-6">
                        <div>
                            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                                🌐 Ethernet Frame Layer-2 Shift Visualizer
                            </h1>
                            <p class="text-slate-400 mt-1 text-sm">
                                Toggle modes to see how a switch injects a 4-Byte VLAN tag without altering standard field sizes.
                            </p>
                        </div>
                        
                        <div class="flex items-center gap-3 bg-slate-900 p-1.5 rounded-xl border border-slate-700">
                            <button 
                                onClick={() => setIsTagged(false)}
                                class={`px-4 py-2 rounded-lg text-sm font-semibold transition-all ${!isTagged ? 'bg-slate-700 text-white shadow-md' : 'text-slate-400 hover:text-slate-200'}`}
                            >
                                Standard Frame
                            </button>
                            <button 
                                onClick={() => setIsTagged(true)}
                                class={`px-4 py-2 rounded-lg text-sm font-semibold transition-all ${isTagged ? 'bg-blue-600 text-white shadow-md' : 'text-slate-400 hover:text-slate-200'}`}
                            >
                                802.1Q Tagged Frame
                            </button>
                        </div>
                    </div>

                    {/* Interactive Tape Display */}
                    <div class="mb-10">
                        <div class="flex justify-between items-center mb-2 px-1 text-xs text-slate-400 font-medium tracking-wider uppercase">
                            <span>Transmission Start (Wire Entry)</span>
                            <span class="mono text-slate-300 bg-slate-900 px-2 py-0.5 rounded border border-slate-700">Max Frame size: {totalBytes}</span>
                        </div>
                        
                        <div class="flex w-full items-stretch rounded-xl overflow-hidden border border-slate-900 shadow-inner bg-slate-950 p-2 min-h-[90px] gap-1.5">
                            {currentFields.map((field) => (
                                <div
                                    key={field.id}
                                    onMouseEnter={() => setHoveredField(field)}
                                    onMouseLeave={() => setHoveredField(null)}
                                    class={`cursor-pointer transition-all duration-200 border-2 rounded-lg p-2 flex flex-col justify-between items-center text-center select-none group min-w-[70px] ${field.color} ${field.flex ? 'flex-1' : ''} ${hoveredField?.id === field.id ? 'scale-[1.02] ring-2 ring-white z-10' : 'opacity-90 hover:opacity-100'}`}
                                >
                                    <span class="text-xs font-bold tracking-wide truncate max-w-full block drop-shadow-md text-white">{field.name}</span>
                                    <div class="mt-2">
                                        <span class="block text-xs font-bold bg-slate-900/40 px-1.5 py-0.5 rounded-md text-white/95 mono">{field.size}</span>
                                        <span class="block text-[10px] text-white/70 mono mt-0.5">{field.bits}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Metadata Context Box */}
                    <div class="bg-slate-900/60 rounded-xl border border-slate-700/60 p-5 min-h-[140px] flex flex-col justify-center">
                        {hoveredField ? (
                            <div>
                                <div class="flex items-center gap-3 mb-2">
                                    <h3 class="text-lg font-bold text-white">{hoveredField.name}</h3>
                                    <span class="mono text-xs font-bold bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700 text-slate-300">
                                        Size: {hoveredField.size} ({hoveredField.bits})
                                    </span>
                                </div>
                                <p class="text-slate-300 text-sm leading-relaxed">{hoveredField.desc}</p>
                            </div>
                        ) : (
                            <div class="text-center py-4">
                                <p class="text-slate-400 text-sm flex items-center justify-center gap-2">
